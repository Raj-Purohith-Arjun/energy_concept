# Basic auth for the whole site (see src/proxy.ts).
# Locally, leaving either unset disables auth. On a deployed Vercel
# environment (production or preview), leaving either unset returns 503.
DEMO_USER=
DEMO_PASS=

# Temporary measurement bypass (PageSpeed). Set to 1 only for a measurement
# deploy, then redeploy without it immediately after.
PERF_PUBLIC=
